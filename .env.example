# ─── アプリケーション共通 ────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-this-to-a-very-secure-random-string-in-production

# ─── データベース ─────────────────────────────────────────────────────
POSTGRES_USER=dao_user
POSTGRES_PASSWORD=dao_pass
POSTGRES_DB=dao_db
DATABASE_URL=postgresql://dao_user:dao_pass@localhost:5432/dao_db

# ─── JWT 認証 ────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Gemini API ──────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# ─── Postiz 連携 ─────────────────────────────────────────────────────
POSTIZ_API_URL=http://localhost:5000/api
POSTIZ_API_KEY=your-postiz-api-key-here
POSTIZ_JWT_SECRET=postiz-secret-change-in-prod

# ─── CORS ────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── フロントエンド (Next.js) ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
